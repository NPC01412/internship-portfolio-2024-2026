@model IEnumerable<Partice.Models.Order>
@using X.PagedList.Mvc.Core;
@using X.PagedList;
@using X.PagedList.Mvc.Core.Fluent;

@{
    ViewData["Title"] = "Prog1";
    var pagedList = (IPagedList)ViewBag.userModel;
}

<h1>Prog1</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.member)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EmID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.goodsway)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.location)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.city)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.zone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.portnumber)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.member)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EmID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.goodsway)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.location)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.city)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.zone)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.portnumber)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ID">Delete</a>
            </td>
        </tr>
}
    </tbody>
    <tfoot>
        <tr>
            <td class="text-muted" colspan="5">
                第@(pagedList.PageCount< pagedList.PageNumber?0:pagedList.PageNumber)頁，共
                @pagedList.PageCount 頁。
                每頁 @pagedList.PageSize 筆資料,全部共有 @pagedList.TotalItemCount 筆資料
            </td>
        </tr>
    </tfoot>
</table>
<div style="align-content:center">
    @(Html.Pager(pagedList).Url(page => Url.Action ("Prog1", new{page})).Build())
</div>

@model IEnumerable<Partice.Models.Order>
@{
    ViewData["Title"] = "Prog2";
}

<h1>Prog2</h1>

<form method="post" action="@Url.Action("Prog2")">
    <div class="form-group">
        <label for="district" class="control-label col-md-2"></label>
        <div class="col-md-10">
            <select id="district" name="district">
                @foreach(var item in ViewBag.District)
                {
                    <option value="@item">@item</option>
                })
            </select>
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="查詢" class="btn btn-primary" />
        </div>
    </div>
</form>